{
  "name": "@chmonitor/launch",
  "private": true,
  "version": "0.3.0",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render:16x9": "remotion render src/index.ts Launch16x9 out/launch-16x9.mp4",
    "render:vertical": "remotion render src/index.ts LaunchVertical9x16 out/launch-vertical.mp4",
    "render:square": "remotion render src/index.ts LaunchSquare1x1 out/launch-square.mp4",
    "render:all": "bun run render:16x9 && bun run render:vertical && bun run render:square",
    "still": "remotion still src/index.ts Launch16x9 out/launch-poster.png --frame=60"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.77",
    "@remotion/cli": "4.0.290",
    "@remotion/google-fonts": "4.0.290",
    "@remotion/transitions": "4.0.290",
    "culori": "^4.0.2",
    "date-fns": "^4.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
